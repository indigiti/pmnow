APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR_HOST/pmnow
APP_BASE_PATH=/pmnow
APP_TIMEZONE=Asia/Kolkata
APP_KEY=REPLACE_WITH_OUTPUT_OF_php_tools_generate-key.php
PERSISTENCE_DRIVER=file
RUNTIME_DRIVER=file
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PREFIX=pmnow:
SSE_ENABLED=false
PYTHON_ENGINE_URL=http://127.0.0.1:8788
PYTHON_ENGINE_TIMEOUT=20
ENGINE_AUTOSTART=false
INTELLIGENCE_EXTERNAL_AI=false
CSRF_ENABLED=true
SESSION_SECURE_COOKIE=true
HSTS_ENABLED=true
MAX_REQUEST_BYTES=1048576
LOGIN_RATE_LIMIT=10
ALLOW_PRIVATE_SOURCE_URLS=false
ADMIN_DEV_BYPASS=false
ADMIN_BOOTSTRAP_EMAIL=CHANGE_ME
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Public VAPID key used by browser subscription registration.
PUSH_VAPID_PUBLIC_KEY=
