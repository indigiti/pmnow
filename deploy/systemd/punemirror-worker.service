[Unit]
Description=Pune Mirror background worker
After=network.target redis.service punemirror-engine.service

[Service]
Type=simple
WorkingDirectory=/var/www/punemirror-now
EnvironmentFile=/var/www/punemirror-now/.env
ExecStart=/usr/bin/php /var/www/punemirror-now/tools/worker-loop.php
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/punemirror-now/storage

[Install]
WantedBy=multi-user.target
