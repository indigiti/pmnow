APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
APP_BASE_PATH=
APP_TIMEZONE=Asia/Kolkata
APP_KEY=dev-only-change-this-key-32chars
PERSISTENCE_DRIVER=file
RUNTIME_DRIVER=file
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PREFIX=pmnow:
SSE_ENABLED=false

PYTHON_ENGINE_URL=http://127.0.0.1:8788
PYTHON_ENGINE_TIMEOUT=20
ENGINE_AUTOSTART=true
ENGINE_PORT=8788
INTELLIGENCE_EXTERNAL_AI=false
# AI_HTTP_ENDPOINT=
# AI_HTTP_TOKEN=

# M7 security
CSRF_ENABLED=true
SESSION_SECURE_COOKIE=false
HSTS_ENABLED=false
MAX_REQUEST_BYTES=1048576
LOGIN_RATE_LIMIT=10
ALLOW_PRIVATE_SOURCE_URLS=false
# CONTENT_SECURITY_POLICY=

# Provider credentials may still be referenced from environment variables,
# or can be written into the encrypted source credential vault from Newsroom.
# INSTAGRAM_ACCESS_TOKEN=
# YOUTUBE_API_KEY=
# X_BEARER_TOKEN=

ADMIN_DEV_BYPASS=true
ADMIN_BOOTSTRAP_EMAIL=admin@punemirror.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!
